# =====================================================================
# .env.example — MODELO de configuração (valores fictícios).
#
# Copie para .env e ajuste:   Copy-Item .env.example .env     (PowerShell)
# O arquivo .env NUNCA vai para o Git (está no .gitignore). Crie um no seu PC
# e outro, diferente, direto no servidor de produção.
# =====================================================================

# ---------- PostgreSQL (usado pelo docker-compose.yml) ----------
POSTGRES_DB=pwncheck
POSTGRES_USER=pwncheck
# Gere uma senha forte: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# Porta publicada na sua máquina. Troque se já houver um PostgreSQL instalado na 5432.
POSTGRES_PORT=5432

# ---------- Aplicação ----------
# "+psycopg" escolhe o driver psycopg 3. A senha deve ser IGUAL à de POSTGRES_PASSWORD.
# No desenvolvimento a aplicação roda fora do Docker, então o host é localhost.
DATABASE_URL=postgresql+psycopg://pwncheck:TROQUE_POR_UMA_SENHA_FORTE@localhost:5432/pwncheck

# Banco usado pelos testes (criado pelo db/init-test-db.sql). Sem esta variável, os testes
# que precisam de banco são pulados. Os testes APAGAM as tabelas deste banco.
TEST_DATABASE_URL=postgresql+psycopg://pwncheck:TROQUE_POR_UMA_SENHA_FORTE@localhost:5432/pwncheck_test

# ---------- Cache de prefixos (fase 3) ----------
HIBP_TIMEOUT_SECONDS=10
CACHE_TTL_HOURS=24               # cópia "fresca": usada sem consultar o HIBP
CACHE_STALE_IF_ERROR_HOURS=168   # depois disso, ainda serve por 7 dias se o HIBP cair
